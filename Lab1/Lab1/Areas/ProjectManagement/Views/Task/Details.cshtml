@model ProjectTask
@{
    ViewData["Title"] = "Task Details";

}


<h2>Task Details</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Title)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Title)</dd>


        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Description)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Description)</dd>


        <dt class="col-sm-2">Project @Html.DisplayNameFor(model => model.Project.Name)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Project.Name)</dd>

        <!--Any other properties that you consider should be displayed here-->
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.ProjectTaskID" class="btn btn-primary">Edit</a>
<a asp-action="Index" asp-route-projectID ="@Model.ProjectID" class="btn btn-secondary">Back to list</a>


